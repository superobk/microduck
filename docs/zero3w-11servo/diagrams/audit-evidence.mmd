flowchart TD
  intent["操作意义 + 后续注意事项<br/>目标/精确脚本/产物哈希"]
  before["执行前持久保存operation.json<br/>脚本按内容SHA归档"]
  run["审计SSH / SCP<br/>启用host-key校验，凭证不入日志"]
  output["流式保存完整输出<br/>失败/断线也保留"]
  after["执行后退出码/UTC/输出SHA<br/>success 或 failed_or_interrupted"]
  index["日志索引 + 文档证据引用<br/>不把软件试验写成实机通过"]
  intent -->|"归档"| before
  before -->|"落盘后执行"| run
  run -->|"完整输出"| output
  output -->|"完成或失败"| after
  after -->|"复用/追踪"| index
